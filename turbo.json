{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [
    "turbo-cache-key.json",
    "test-support/fixtures/share-url-v1-v2.json",
    "test-support/fixtures/codex-legacy-warning-envelopes.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "patches/*.patch"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "build:desktop": {
      "dependsOn": ["^build", "@inkeep/open-knowledge#build"],
      "outputs": ["out/**"]
    },
    "dev:electron": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "OK_INSTANCE",
        "OK_AUTO_INSTANCE",
        "OK_M6B_FORCE",
        "OK_RECLAIM_DISABLE",
        "OK_UNINSTALL_UI_PREVIEW",
        "OK_FEEDBACK_INTAKE_ORIGIN"
      ]
    },
    "build:desktop:dir": {
      "dependsOn": ["build:desktop"],
      "outputs": ["dist-desktop/**"],
      "env": ["ELECTRON_CACHE", "ELECTRON_MIRROR"]
    },
    "rebuild:native": {
      "cache": false,
      "dependsOn": []
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck:no-net-connect"]
    },
    "//#typecheck:no-net-connect": {
      "inputs": [
        "test-support/*.ts",
        "test-support/*.mts",
        "test-support/fixtures/no-net-connect/**/*.ts",
        "test-support/tsconfig.no-net-connect.json",
        "tsconfig.json"
      ]
    },
    "//#test:uncached": {
      "cache": false,
      "inputs": []
    },
    "@inkeep/open-knowledge#check:dts": {
      "dependsOn": ["build"],
      "inputs": [
        "tsconfig.check.json",
        "scripts/check-published-dts.mjs",
        "$TURBO_ROOT$/scripts/read-jsonc.mjs"
      ]
    },
    "@inkeep/open-knowledge-docs#build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.test-helper.ts",
        "!vitest.config.ts",
        "!vitest.*.config.mts"
      ],
      "env": [
        "VERCEL_GIT_COMMIT_SHA",
        "GITHUB_SHA",
        "VERCEL_ENV",
        "OK_ALLOW_BLOGLESS_LLMS_TXT",
        "CI",
        "VERCEL"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"]
    },
    "@inkeep/open-knowledge-docs#test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"]
    },
    "@inkeep/open-knowledge-server#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "with": ["//#test:uncached"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "../../test-support/*.ts",
        "../../test-support/test-only-source-file.mjs",
        "../app/src/editor/observers.ts"
      ]
    },
    "@inkeep/open-knowledge#test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "$TURBO_ROOT$/scripts/read-jsonc.mjs"
      ]
    },
    "@inkeep/open-knowledge-desktop#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!CHANGELOG.md",
        "!README.md",
        "$TURBO_ROOT$/lint-plugins/no-comments/**",
        "$TURBO_ROOT$/test-support/**",
        "../../scripts/verify-native-config-in-packaged-dmg.mjs",
        "../../scripts/verify-keyring-in-packaged-dmg.mjs",
        "../../scripts/lume-bake/**",
        "../../scripts/lume-qa/**",
        "../app/vite.*.ts",
        "../app/lingui.config.ts",
        "../app/postcss.config.ts",
        "../app/*.html",
        "../app/src/**",
        "!../app/src/**/*.md"
      ]
    },
    "@inkeep/md-conformance#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**", "../server/src/**/*.ts"]
    },
    "@inkeep/open-knowledge-core#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"]
    },
    "test:dom": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../core/src/**/*.ts",
        "../server/src/**/*.ts",
        "../md-conformance/src/**/*.ts",
        "../md-conformance/src/**/*.json",
        "../md-conformance/corpora/typed-view-scripts.json"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../server/src/**/*.ts",
        "../core/src/**/*.ts",
        "$TURBO_ROOT$/lint-plugins/no-comments/**",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json"
      ]
    },
    "test:integration:shard1": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../server/src/**/*.ts",
        "../core/src/**/*.ts",
        "$TURBO_ROOT$/lint-plugins/no-comments/**",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json"
      ]
    },
    "test:integration:shard2": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../server/src/**/*.ts",
        "../core/src/**/*.ts",
        "$TURBO_ROOT$/lint-plugins/no-comments/**",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json"
      ]
    },
    "test:integration:shard3": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../server/src/**/*.ts",
        "../core/src/**/*.ts",
        "$TURBO_ROOT$/lint-plugins/no-comments/**",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json"
      ]
    },
    "test:conversion": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test-support/**",
        "../core/src/**/*.ts",
        "../server/src/**/*.ts"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "test:visual": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@inkeep/open-knowledge-app#test:visual": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "test:perf": {
      "dependsOn": [],
      "cache": false,
      "inputs": [
        "src/editor/**/*.ts",
        "src/editor/**/*.tsx",
        "tests/stress/component-blocks.perf.test.ts",
        "vitest.config.ts",
        "vite.dedupe.ts",
        "tests/lingui-macro-shim.tsx",
        "tests/integration/idb-preload.ts",
        "$TURBO_ROOT$/test-support/**",
        "../core/src/**/*.ts"
      ]
    },
    "test:a11y": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@inkeep/open-knowledge-app#test:a11y": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "test:perf:bench": {
      "dependsOn": [],
      "cache": false,
      "inputs": [
        "src/markdown/**/*.ts",
        "src/markdown/fixtures/perf/*.md",
        "tests/perf/markdown-bench.test.ts"
      ],
      "env": ["RUN_BENCH", "BENCH_RUNNER_CLASS"]
    },
    "test:perf:regression:unit": {
      "dependsOn": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"]
    },
    "test:perf:regression": {
      "dependsOn": [],
      "cache": false,
      "inputs": [
        "src/markdown/**/*.ts",
        "src/markdown/fixtures/perf/*.md",
        "tests/perf/markdown-bench.test.ts",
        "tests/perf/regression-gate.ts",
        "tests/perf/run-regression-gate.ts",
        "tests/perf/baseline.json"
      ],
      "env": ["RUN_BENCH", "BENCH_RUNNER_CLASS"]
    },
    "test:health:unit": {
      "dependsOn": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test-support/**"]
    },
    "test:health": {
      "dependsOn": [],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:perf:sessions": {
      "dependsOn": [],
      "cache": false,
      "inputs": [
        "tests/integration/per-session-um-perf.test.ts",
        "../server/src/**/*.ts",
        "../core/src/**/*.ts"
      ]
    },
    "perf:profile": {
      "dependsOn": [],
      "cache": false,
      "inputs": ["src/lib/perf/**/*.ts", "src/lib/perf/**/*.tsx", "tests/perf/**/*.ts"],
      "passThroughEnv": ["DISPLAY", "OK_PERF_TARGET"]
    }
  }
}
