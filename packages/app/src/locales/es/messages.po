msgid "This agent runs through {0}, which is installed but won't run — its {1} looks broken. Open Knowledge can download a private copy of {2} {3} (about {4} MB from {5}) that won't touch the rest of your system."
msgstr "Este agente funciona con {0}, que está instalado pero no arranca: su {1} parece estar dañado. Open Knowledge puede descargar una copia privada de {2} {3} (unos {4} MB desde {5}) que no tocará el resto de tu sistema."

msgid "This agent runs through {0}, which isn't installed. Open Knowledge can download a private copy of {1} {2} (about {3} MB from {4}) that won't touch the rest of your system."
msgstr "Este agente funciona con {0}, que no está instalado. Open Knowledge puede descargar una copia privada de {1} {2} (unos {3} MB desde {4}) que no tocará el resto de tu sistema."

msgid "This also installs the pack's {packSkillCount, plural, one {# skill} other {# skills}}."
msgstr "Esto también instala {packSkillCount, plural, one {# habilidad} many {# habilidades} other {# habilidades}} del paquete."

msgid "This branch does not contain this OpenKnowledge project. The worktree was created but not opened."
msgstr "Esta rama no contiene este proyecto de OpenKnowledge. El worktree se creó, pero no se abrió."

