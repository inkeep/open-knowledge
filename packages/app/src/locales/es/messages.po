msgid "Terminal failed to load"
msgstr "No se pudo cargar la terminal"

msgid "Terminal sessions"
msgstr "Sesiones de terminal"

msgid "Terminal settings not loaded yet — try again in a moment."
msgstr "Los ajustes de la terminal aún no se han cargado; inténtalo de nuevo en un momento."

