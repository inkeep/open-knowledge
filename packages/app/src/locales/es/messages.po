msgstr "Esto está tardando más de lo habitual. Recargar la ventana suele solucionarlo."

msgid "This isn’t a regular theme file"
msgstr "Este no es un archivo de tema normal"

msgid "This isn't a supported version of Slidev."
msgstr "Esta no es una versión compatible de Slidev."

msgid "this item"
msgstr "este elemento"

msgid "This list may be out of date — last read {staleRelative}."
msgstr "Puede que esta lista esté desactualizada; última lectura: {staleRelative}."

