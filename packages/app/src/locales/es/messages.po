msgstr "Este {targetNoun} solo existe en la rama <0>{shareBranch}</0>. Tienes cambios sin confirmar que impiden cambiar aquí: ábrelo en un worktree para dejar tus cambios intactos."

msgid "This {targetNoun} was added to branch <0>{shareBranch}</0> recently. Switch and update to open it."
msgstr "Este {targetNoun} se añadió hace poco a la rama <0>{shareBranch}</0>. Cambia y actualiza para abrirlo."

msgid "This {targetNoun} was removed from branch <0>{branch}</0>."
msgstr "Este {targetNoun} se quitó de la rama <0>{branch}</0>."

msgid "This {targetNoun} was shared from branch <0>{shareBranch}</0>. It doesn't exist on your current branch (<1>{currentLabel}</1>)."
msgstr "Este {targetNoun} se compartió desde la rama <0>{shareBranch}</0>. No existe en tu rama actual (<1>{currentLabel}</1>)."

msgid "This {targetNoun} was shared from branch <0>{shareBranch}</0>. You're currently on <1>{currentLabel}</1>."
msgstr "Este {targetNoun} se compartió desde la rama <0>{shareBranch}</0>. Ahora mismo estás en <1>{currentLabel}</1>."

msgid "This agent doesn't accept attachments — remove them or choose an in-app agent."
msgstr "Este agente no acepta adjuntos — quítalos o elige un agente integrado en la app."

msgid "This agent doesn't offer slash commands"
