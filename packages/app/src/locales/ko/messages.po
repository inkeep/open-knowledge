msgid "<{descriptorLabel}> failed to render (likely a bad prop). Copy the source to see what went wrong, or delete the block."
msgstr "<{descriptorLabel}> 컴포넌트를 렌더링하지 못했습니다. 잘못된 속성 때문일 수 있습니다. 문제를 확인하려면 소스를 복사하거나 블록을 삭제하세요."

#. Warning shown when the user unchecks the PATH toggle on a desktop build with the built-in terminal
msgid "<0>{cliCommand}</0> won't run in external terminals until you add it later from the File menu. OpenKnowledge's built-in terminal and AI tools keep working."
msgstr "<0>{cliCommand}</0> 외부 터미널 실행 불가. File 메뉴에서 나중에 추가하면 실행할 수 있습니다. OpenKnowledge 내장 터미널과 AI 도구도 계속 작동합니다."

#. Warning shown when the user unchecks the PATH toggle on a desktop build without the built-in terminal
msgid "<0>{cliCommand}</0> won't run in external terminals until you add it later from the File menu. Your AI tools keep working."
msgstr "<0>{cliCommand}</0>는 나중에 파일 메뉴에서 추가할 때까지 외부 터미널에서 실행되지 않습니다. AI 도구는 계속 작동합니다."

msgid "<0>{filePath}</0> can't be merged here. Pick the version to keep."
msgstr "<0>{filePath}</0>은 여기에서 병합할 수 없습니다. 유지할 버전을 고르세요."

msgid "<0>Mirror — pick a source.</0> Set <1>src</1> + <2>anchor</2> via the property panel to point at a <3><MirrorSource></3> elsewhere."
msgstr "<0>미러, 소스를 선택하세요.</0> 속성 패널에서 <1>src</1>와 <2>anchor</2>를 설정해 다른 곳의 <3><MirrorSource></3>를 가리키세요."

msgid "<0>Mirror anchor not found.</0> No <1>{mirrorSourceTag}</1> exists in <2>{src}</2>."
msgstr "<0>미러 앵커를 찾을 수 없습니다.</0> <1>{mirrorSourceTag}</1>가 <2>{src}</2>에 없습니다."

msgid "<0>Mirror source removed.</0> The doc <1>{src}</1> is no longer available."
msgstr "<0>미러 소스가 삭제되었습니다.</0> 문서 <1>{src}</1>는 더 이상 사용할 수 없습니다."

msgid "<0>Space</0> to jump · <1>↓</1> to duck"
msgstr "<0>스페이스</0>로 점프 · <1>↓</1>로 숙이기"

msgid "<0>Too many live references on this page.</0> This mirror of <1>{src}</1> was not loaded."
msgstr "<0>이 페이지에 라이브 참조가 너무 많습니다.</0> <1>{src}</1>의 이 미러는 불러오지 않았습니다."

msgid "~/.myteam/skills"
msgstr "~/.myteam/skills"

