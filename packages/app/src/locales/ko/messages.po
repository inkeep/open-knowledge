msgid "Symlink"
msgstr "심볼릭 링크"

msgid "Symlink to {targetPath}"
msgstr "심볼릭 링크: {targetPath}"

msgid "symlinked via parent"
msgstr "상위 경로를 통한 심볼릭 링크"

msgid "Symlinks the skill to {path}"
msgstr "{path}에 스킬을 심볼릭 링크합니다"

msgid "Sync"
msgstr "동기화"

msgid "Sync & sharing"
msgstr "동기화 및 공유"

msgid "Sync failed — check the server logs for details."
msgstr "동기화 실패. 자세한 내용은 서버 로그를 확인하세요."

msgid "Sync is failing. See the sync status for details."
msgstr "동기화에 실패하고 있습니다. 자세한 내용은 동기화 상태를 확인하세요."

msgid "Sync is paused because incoming changes leave a symlink pointing outside the repository or into private files, or with a target that cannot be checked. Ask whoever pushed them to fix the link, or update Git if yours is older than 2.38. Automatic sync then resumes; in Manual mode, pull again."
msgstr "들어오는 변경 사항으로 인해 심볼릭 링크가 저장소 밖이나 비공개 파일을 가리키거나 대상을 확인할 수 없게 되어 동기화가 일시 중지되었습니다. 푸시한 사람에게 링크 수정을 요청하거나, Git 버전이 2.38보다 오래되었다면 Git을 업데이트하세요. 그러면 자동 동기화가 다시 시작되며, 수동 모드에서는 다시 풀하세요."

msgid "Sync is paused. Commit these local edits to continue, or sort them out in a terminal."
msgstr "동기화가 일시 중지되었습니다. 계속하려면 이 로컬 편집 내용을 커밋하거나 터미널에서 정리하세요."

msgid "Sync is set to Auto (Pull and Push) for this worktree, inherited from {project}. Change it in Settings → Sync."
msgstr "이 워크트리의 동기화가 자동(풀 및 푸시)으로 설정되어 있습니다. {project}에서 상속되었습니다. 설정 → 동기화에서 변경하세요."

msgid "Sync is set to Auto (Pull only) for this worktree, inherited from {project}. Change it in Settings → Sync."
msgstr "이 워크트리의 동기화가 자동(풀만)으로 설정되어 있습니다. {project}에서 상속되었습니다. 설정 → 동기화에서 변경하세요."

msgid "Sync is set to Manual for this worktree, inherited from {project}. Change it in Settings → Sync."
msgstr "이 워크트리의 동기화가 수동으로 설정되어 있습니다. {project}에서 상속되었습니다. 설정 → 동기화에서 변경하세요."

msgid "Sync is taking longer than usual — your changes are safe on this device."
msgstr "동기화가 평소보다 오래 걸리고 있습니다. 변경 내용은 이 기기에 안전하게 보관됩니다."

msgid "Sync keeps this computer's copy up to date with your Git remote. The shared settings below decide what teammates get when they open the project."
msgstr "동기화는 이 컴퓨터의 사본을 Git 원격과 최신 상태로 유지합니다. 아래 공유 설정은 팀원이 프로젝트를 열 때 무엇을 받을지 결정합니다."

msgid "Sync mode"
msgstr "동기화 모드"

msgid "Sync now"
msgstr "지금 동기화"

msgid "Sync paused"
msgstr "동기화 일시 중지됨"

msgid "Sync paused — you don't have permission to push to this repo"
msgstr "동기화 일시 중지됨, 이 리포지토리에 푸시할 권한이 없습니다"

msgid "Sync settings not yet loaded — try again in a moment"
msgstr "동기화 설정이 아직 로드되지 않았습니다. 잠시 후 다시 시도하세요."

msgid "Sync status unavailable"
msgstr "동기화 상태 사용 불가"

msgid "Sync status unavailable — server error."
msgstr "동기화 상태 사용 불가. 서버 오류입니다."

msgid "Sync status unavailable — server unreachable."
msgstr "동기화 상태 사용 불가. 서버에 연결할 수 없습니다."

msgid "Sync status: {syncStateLabel}"
msgstr "동기화 상태: {syncStateLabel}"

msgid "Sync status: {syncStateLabel} — git identity unset"
msgstr "동기화 상태: {syncStateLabel}. git 사용자 정보가 설정되지 않았습니다."

msgid "Synced"
msgstr "동기화됨"

msgid "Synced from disk"
msgstr "디스크에서 동기화됨"

msgid "Synced. The link is up to date."
msgstr "동기화됨. 링크가 최신 상태입니다."

msgid "Syncing"
msgstr "동기화 중"

msgid "Syncing your changes"
msgstr "변경 사항 동기화 중"

msgid "System"
msgstr "시스템"

msgid "System error"
msgstr "시스템 오류"

