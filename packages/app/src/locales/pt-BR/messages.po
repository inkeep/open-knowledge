msgstr "Este {targetNoun} foi movido, renomeado ou excluído na sua cópia local, e essa mudança ainda não sincronizou."

msgid "This {targetNoun} has been moved, renamed, or deleted in your local copy. Please commit your changes or enable auto-sync."
msgstr "Este {targetNoun} foi movido, renomeado ou excluído na sua cópia local. Faça commit das suas alterações ou ative a sincronização automática."

msgid "This {targetNoun} isn't on branch <0>{branch}</0>. It may not have been pushed yet."
msgstr "Este {targetNoun} não está no ramo <0>{branch}</0>. Pode ser que ainda não tenha sido enviado."

