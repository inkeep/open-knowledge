msgid "That endpoint can't be used. Enter an https:// URL — http:// is only allowed for loopback endpoints."
msgstr "Tego punktu końcowego nie można użyć. Podaj adres https:// — http:// jest dozwolone tylko dla punktów końcowych loopback."

msgid "That folder already holds code Open Knowledge didn't write, which the same trust would let {0} run: {otherExtensions}."
msgstr "Ten folder zawiera już kod napisany nie przez Open Knowledge, którego ta sama zgoda pozwoliłaby {0} uruchomić: {otherExtensions}."

