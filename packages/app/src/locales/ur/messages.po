msgstr "ایجنٹ رک نہیں رہا۔ زبردستی روکنے سے یہ چیٹ بند ہو جائے گی اور ایجنٹ ختم ہو جائے گا۔"

msgid "The agent process ended on its own."
msgstr "ایجنٹ پروسیس خود بخود ختم ہو گیا۔"

