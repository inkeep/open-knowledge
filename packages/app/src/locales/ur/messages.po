#. js-lingui-explicit-id
msgid "troubleshooting.codex.desktop-project-config"
msgstr "{agent} ڈیسک ٹاپ ایپ اس پروجیکٹ کنفیگ کو نظر انداز کرتی ہے؛ اسے صرف {agent} CLI پڑھتا ہے۔"

msgid "The {editor} folder holds a different version of this skill. Pick which one wins, or keep both under different names. Whatever you replace is backed up first."
msgstr "{editor} فولڈر میں اس مہارت کا ایک مختلف ورژن ہے۔ منتخب کریں کہ کون سا غالب رہے، یا دونوں کو مختلف ناموں سے رکھیں۔ آپ جو بھی بدلیں گے اس کا پہلے بیک اپ لے لیا جاتا ہے۔"

msgid "The {editor} version is now the source"
msgstr "اب {editor} والا ورژن ماخذ ہے"

