#. js-lingui-explicit-id
msgid "troubleshooting.claude-desktop.per-tool-approval"
msgstr "{agent} ہر OpenKnowledge ٹول کے پہلے استعمال پر آپ سے منظوری مانگتا ہے۔"

#. js-lingui-explicit-id
msgid "guidance.mcp.session-injection"
msgstr "جب بھی OpenKnowledge {agent} کو چلاتا ہے، اسے OpenKnowledge کے ٹولز ملتے ہیں؛ اس کی کنفیگ میں کچھ نہیں لکھا جاتا۔"

#. js-lingui-explicit-id
msgid "followup.enable-manually"
msgstr "{agent} پروجیکٹ کے MCP سرورز اُس وقت تک بند رکھتا ہے جب تک آپ انہیں Customize → MCPs میں آن نہ کریں۔ OpenKnowledge اس سیٹنگ کو نہیں دیکھ سکتا۔"

#. js-lingui-explicit-id
msgid "troubleshooting.codex.folder-trust"
msgstr "{agent} پروجیکٹ کا اندراج صرف اُس فولڈر میں لوڈ کرتا ہے جس پر آپ نے اعتماد کیا ہو۔ CLI نئے فولڈر میں پہلی بار چلانے پر پوچھتی ہے، مگر codex exec پوچھ نہیں سکتا اور پرانے بلڈ شاید جواب یاد نہ رکھیں، اس لیے اگر ٹولز نظر نہ آئیں تو ~/.codex/config.toml میں پروجیکٹ کو قابلِ اعتماد کے طور پر نشان زد کریں۔ کسی پروجیکٹ پر اعتماد کرنے سے اس کی پوری .codex/ پرت لوڈ ہوتی ہے، جس میں hooks اور قواعد بھی شامل ہیں۔"

#. js-lingui-explicit-id
msgid "troubleshooting.pi.folder-trust"
msgstr "{agent} پروجیکٹ ایکسٹینشنز صرف انہی فولڈرز میں لوڈ کرتا ہے جن پر آپ نے اعتماد کیا ہو؛ اگر ٹولز نظر نہ آئیں تو {agent} میں اس فولڈر پر اعتماد کریں۔"

#. js-lingui-explicit-id
msgid "troubleshooting.copilot.shared-workspace-config"
msgstr "{agent} وہی ورک اسپیس MCP کنفیگ پڑھتا ہے جو OpenKnowledge {sourceAgent} کے لیے لکھتا ہے؛ ایک کے لیے ہٹانے پر یہ دونوں کے لیے ہٹ جاتی ہے۔ {agent} اسے تبھی لوڈ کرتا ہے جب آپ پہلی بار شروع کرتے وقت فولڈر کے اعتماد کی تصدیق کریں، اور جس فولڈر پر آپ نے اعتماد نہ کیا ہو وہاں اسے خاموشی سے چھوڑ دیتا ہے، copilot -p میں بھی، جہاں اعتماد کا پیغام دکھایا ہی نہیں جا سکتا۔"

#. js-lingui-explicit-id
msgid "troubleshooting.openclaw.central-store-missing"
