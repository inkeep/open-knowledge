msgstr "انتباہ"

msgid "We couldn't check whether Slidev is installed. Return to this window to retry."
msgstr "ہم جانچ نہیں سکے کہ Slidev انسٹال ہے یا نہیں۔ دوبارہ کوشش کے لیے اس ونڈو پر واپس آئیں۔"

msgid "We couldn't check your GitHub connection."
msgstr "ہم آپ کا GitHub کنکشن نہیں جانچ سکے۔"

msgid "We couldn't clone this repository."
msgstr "ہم یہ ریپازٹری کلون نہیں کر سکے۔"

msgid "We'll build <0>openknowledge.skill</0>, save it to <1>~/Downloads</1>, and open the Claude Desktop App for you."
msgstr "ہم <0>openknowledge.skill</0> بنائیں گے، اسے <1>~/Downloads</1> میں محفوظ کریں گے، اور آپ کے لیے Claude Desktop App کھول دیں گے۔"

msgid "We'll create a repository and start syncing — no terminal needed."
msgstr "ہم ایک ریپازٹری بنا کر مطابقت پذیری شروع کر دیں گے — کسی ٹرمینل کی ضرورت نہیں۔"

msgid "We’ll create a safe theme ID from this name."
msgstr "ہم اس نام سے ایک محفوظ تھیم ID بنائیں گے۔"

msgid "We've filed it with the team and attached your logs."
msgstr "ہم نے اسے ٹیم کے پاس درج کر دیا ہے اور آپ کے لاگز منسلک کر دیے ہیں۔"

msgid "Welcome to OpenKnowledge"
msgstr "OpenKnowledge میں خوش آمدید"

#. Button on each setup row that opens the list of files that row writes to
msgid "What changes?"
msgstr "کیا تبدیل ہوگا؟"

msgid "What config sharing covers"
msgstr "کنفیگ کا اشتراک کیا شامل کرتا ہے"

msgid "What gets created"
msgstr "کیا بنتا ہے"

msgid "What got in the way?"
msgstr "کیا رکاوٹ بنا؟"

msgid "What happened?"
msgstr "کیا ہوا؟"

msgid "What happens next"
msgstr "آگے کیا ہو گا"

msgid "What is a starter pack?"
msgstr "ابتدائی پیک کیا ہے؟"

msgid "What is the difference between copies and symlinks?"
msgstr "نقول اور سِم لنکس میں کیا فرق ہے؟"

msgid "What is this knowledge base for?"
msgstr "یہ نالج بیس کس لیے ہے؟"

msgid "What should we work on?"
msgstr "ہم کس چیز پر کام کریں؟"

msgid "What the agent may read, write, and surface."
msgstr "ایجنٹ کیا پڑھ، لکھ اور ظاہر کر سکتا ہے۔"

msgid "What this checkbox changes"
msgstr "یہ چیک باکس کیا بدلتا ہے"

msgid "What to include"
msgstr "کیا شامل کرنا ہے"

msgid "What were you doing?"
msgstr "آپ کیا کر رہے تھے؟"

msgid "What would you like to create?"
msgstr "آپ کیا بنانا چاہیں گے؟"

msgid "What you share is sent to the OpenKnowledge team."
msgstr "آپ جو شیئر کرتے ہیں وہ OpenKnowledge ٹیم کو بھیجا جاتا ہے۔"

msgid "What's included"
msgstr "کیا شامل ہے"

msgid "What's new"
msgstr "نیا کیا ہے"

msgid "When enabled, the agent opens or refreshes the preview after each edit. Disable if you manage your own preview window (OK Desktop, a browser tab on another display, etc.)."
msgstr "فعال ہونے پر، ایجنٹ ہر ترمیم کے بعد پیش منظر کھولتا یا تازہ کرتا ہے۔ اگر آپ اپنی پیش منظر ونڈو خود سنبھالتے ہیں تو اسے بند کر دیں (OK Desktop، کسی اور ڈسپلے پر براؤزر ٹیب، وغیرہ)۔"

msgid "When the agent runs its scheduled work."
msgstr "ایجنٹ اپنا طے شدہ کام کب چلاتا ہے۔"

msgid "When the Comments tab is open"
msgstr "جب تبصرے ٹیب کھلا ہو"

msgid "When you hover an external link, its URL is sent to the destination site to fetch the page's preview metadata — one request per previewed link."
msgstr "جب آپ کسی بیرونی لنک پر ماؤس لے جاتے ہیں تو صفحے کا پیش منظر ڈیٹا لانے کے لیے اس کا URL منزل کی سائٹ کو بھیجا جاتا ہے — ہر پیش منظر والے لنک کے لیے ایک درخواست۔"

msgid "When you install a published skill, tell the skill directory (skills.sh) so its install count is accurate. Sends the skill name, its source repository, and which agent tools it went to — never file contents, and never for a skill from a private, local, or hand-typed source. Once per skill per machine."
msgstr "جب آپ کوئی شائع شدہ مہارت نصب کریں تو مہارتوں کی ڈائریکٹری (skills.sh) کو بتائیں تاکہ اس کی تنصیبات کی تعداد درست رہے۔ مہارت کا نام، اس کا ماخذ ریپازٹری، اور یہ کہ وہ کن ایجنٹ ٹولز میں گئی، بھیجا جاتا ہے — فائلوں کا مواد کبھی نہیں، اور نجی، مقامی یا ہاتھ سے لکھے ماخذ کی مہارت کے لیے کبھی نہیں۔ ہر مشین پر ہر مہارت کے لیے ایک بار۔"

msgid "Where"
msgstr "کہاں"

msgid "Where newly added attachments are placed."
msgstr "نئے شامل ہونے والے منسلکات کہاں رکھے جاتے ہیں۔"

msgid "Where should it live?"
msgstr "یہ کہاں رہنا چاہیے؟"

msgid "Which skill"
msgstr "کون سی مہارت"

msgid "Whitespace"
msgstr "خالی جگہ"

msgid "Who you are, so the agent has your context."
msgstr "آپ کون ہیں، تاکہ ایجنٹ کو آپ کا سیاق معلوم ہو۔"

msgid "Whole word"
msgstr "پورا لفظ"

msgid "Why this needs attention"
msgstr "اس پر توجہ کیوں درکار ہے"

msgid "Wiki link"
msgstr "وکی لنک"

msgid "Wiki link suggestions"
msgstr "وکی لنک کی تجاویز"

msgid "Wiki-links like [[Page]] — a supported way to link here, but an external reader resolves nothing and shows the brackets."
msgstr "وکی لنکس جیسے [[Page]] — یہاں لنک کرنے کا ایک معاون طریقہ ہے، لیکن ایک بیرونی ریڈر کچھ بھی حل نہیں کرتا اور بریکٹ دکھاتا ہے۔"

msgid "Will be created as <0>{effective}</0>"
msgstr "<0>{effective}</0> کے طور پر بنایا جائے گا"

msgid "Will be created as <0>{sanitizedName}</0>"
msgstr "<0>{sanitizedName}</0> کے نام سے بنے گا"

msgid "Will be created at: <0>{targetPreview}</0>"
msgstr "یہاں بنے گا: <0>{targetPreview}</0>"

msgid "Will be saved as <0>{sanitized}</0>."
msgstr "<0>{sanitized}</0> کے نام سے محفوظ ہو گا۔"

msgid "Window"
msgstr "ونڈو"

msgid "Without a connected AI tool, the pack's {packSkillCount, plural, one {# skill} other {# skills}} won't be installed."
msgstr "منسلک AI ٹول کے بغیر پیک کی {packSkillCount, plural, one {# مہارت} other {# مہارتیں}} انسٹال نہیں ہوں گی۔"

msgid "Without the skill the agent still works, but it loses edit attribution and the live preview."
msgstr "اسکل کے بغیر ایجنٹ پھر بھی کام کرتا ہے، لیکن وہ ترامیم کا انتساب اور براہِ راست پیش منظر کھو دیتا ہے۔"

msgid "Word wrap"
msgstr "الفاظ کی لپیٹ"

msgid "Work directly, no plan step"
msgstr "براہ راست کام کریں، منصوبہ بندی کے مرحلے کے بغیر"

msgid "Work through these comments"
msgstr "ان تبصروں پر کام کریں"

msgid "Working"
msgstr "کام جاری ہے"

msgid "Workspace"
msgstr "ورک اسپیس"

msgid "Workspace Command Palette"
msgstr "ورک اسپیس کمانڈ پیلیٹ"

msgid "worktree"
msgstr "ورک ٹری"

msgid "worktree of {worktreeOf}"
msgstr "{worktreeOf} کا ورک ٹری"

msgid "Worktrees"
msgstr "ورک ٹریز"

msgid "Wrap long lines in the markdown source editor."
msgstr "Markdown سورس ایڈیٹر میں لمبی سطریں لپیٹیں۔"

#. js-lingui-explicit-id
msgid "guidance.mcp.managed-file"
msgstr "ایک چھوٹی برج فائل لکھتا ہے جسے {agent} اس پروجیکٹ سے لوڈ کر کے OpenKnowledge تک پہنچتا ہے۔"

msgid "Writes an entry to"
msgstr "اس میں ایک اندراج لکھتا ہے"

msgid "writing"
msgstr "لکھائی"

msgid "Writing this file failed. Check the OpenKnowledge log for the reason."
msgstr "یہ فائل لکھنے میں ناکامی ہوئی۔ وجہ جاننے کے لیے OpenKnowledge لاگ دیکھیں۔"

msgid "Wrote the Open Knowledge extension, but couldn't mark the folder trusted, so it won't load. This thread has no Open Knowledge tools."
msgstr "Open Knowledge ایکسٹینشن لکھ دی گئی، لیکن فولڈر کو قابلِ اعتماد نشان زد نہیں کیا جا سکا، اس لیے یہ لوڈ نہیں ہوگی۔ اس تھریڈ میں Open Knowledge ٹولز نہیں ہیں۔"

msgid "YAML or JSON, in either base16 layout."
msgstr "YAML یا JSON، base16 کے کسی بھی خاکے میں۔"

msgid "yesterday"
msgstr "کل"

msgid "You already have your own skill named \"{0}\" — the pack's version will not be installed, and yours won't be touched. Rename yours to install the pack's version."
msgstr "«{0}» نام سے آپ کی اپنی اسکل پہلے سے موجود ہے — پیک والا ورژن انسٹال نہیں ہوگا اور آپ کی اسکل میں کوئی تبدیلی نہیں ہوگی۔ پیک والا ورژن انسٹال کرنے کے لیے اپنی اسکل کا نام تبدیل کریں۔"

#. Label above the optional skill offered on first visit
msgid "You can add"
msgstr "آپ شامل کر سکتے ہیں"

msgid "You can also create one from a terminal with <0>{cliCommand} bug-report</0>."
msgstr "آپ ٹرمینل سے <0>{cliCommand} bug-report</0> کے ذریعے بھی ایک بنا سکتے ہیں۔"

msgid "You can also manage this in Settings."
msgstr "آپ اسے ترتیبات میں بھی سنبھال سکتے ہیں۔"

msgid "You can attach up to {MAX_ATTACHMENTS} images."
msgstr "آپ زیادہ سے زیادہ {MAX_ATTACHMENTS} تصاویر منسلک کر سکتے ہیں۔"

msgid "You can change this later in <0>Settings → Sync</0>."
msgstr "آپ اسے بعد میں <0>ترتیبات ← مطابقت پذیری</0> میں بدل سکتے ہیں۔"

msgid "You can restore this file from the Recycle Bin."
msgstr "آپ اس فائل کو ری سائیکل بن سے بحال کر سکتے ہیں۔"

msgid "You can restore this file from the Trash."
msgstr "آپ اس فائل کو ردی سے بحال کر سکتے ہیں۔"

msgid "You cancelled loading \"{docName}\"."
msgstr "آپ نے «{docName}» کا لوڈ ہونا منسوخ کر دیا۔"

msgid "You deleted <0>{filePath}</0> locally, but it was modified upstream."
msgstr "آپ نے <0>{filePath}</0> مقامی طور پر حذف کی، مگر اپ سٹریم اس میں ترمیم ہوئی۔"

msgid "You denied this. To let it run, ask the agent to try again and approve it."
msgstr "آپ نے اسے مسترد کیا۔ اسے چلانے کے لیے ایجنٹ سے دوبارہ کوشش کرنے کو کہیں اور منظوری دیں۔"

msgid "You don't have access to this private repo. Sign in with an account that does."
msgstr "آپ کو اس نجی ریپو تک رسائی نہیں۔ کسی ایسے اکاؤنٹ سے سائن اِن کریں جسے رسائی ہو۔"

msgid "You don't have access to this repository."
msgstr "آپ کو اس ریپازٹری تک رسائی نہیں۔"

msgid "You don't have permission to push to this repo."
msgstr "آپ کو اس ریپو میں پُش کرنے کی اجازت نہیں۔"

msgid "You don't have permission to push to this repo. Auto (Pull only) can still keep your copy up to date."
msgstr "آپ کو اس ریپازٹری میں پُش کرنے کی اجازت نہیں۔ خودکار (صرف کھینچیں) پھر بھی آپ کی کاپی تازہ رکھ سکتا ہے۔"

msgid "You don't have write access to this repo."
msgstr "آپ کو اس ریپو میں لکھنے کی رسائی نہیں۔"

msgid "You edited this skill locally and the source has new changes. Taking upstream replaces your version; your edits stay recoverable in version history."
msgstr "آپ نے یہ مہارت مقامی طور پر بدلی اور ماخذ میں نئی تبدیلیاں ہیں۔ اپ سٹریم لینا آپ کے ورژن کی جگہ لے لیتا ہے؛ آپ کی ترامیم ورژن کی تاریخ میں بحالی کے قابل رہتی ہیں۔"

msgid "You modified <0>{filePath}</0> locally, but it was deleted upstream."
msgstr "آپ نے <0>{filePath}</0> میں مقامی طور پر ترمیم کی، مگر اپ سٹریم یہ حذف ہو گئی۔"

msgid "You picked ~/Desktop. OpenKnowledge will index everything on your desktop."
msgstr "آپ نے ~/Desktop منتخب کیا۔ OpenKnowledge آپ کے ڈیسک ٹاپ کی ہر چیز اشاریہ بند کرے گا۔"

msgid "You picked ~/Documents. OpenKnowledge will index every markdown file under it. If you only want to manage a sub-folder, choose a smaller scope."
msgstr "آپ نے ~/Documents منتخب کیا۔ OpenKnowledge اس کے تحت ہر Markdown فائل اشاریہ بند کرے گا۔ اگر آپ صرف کوئی ذیلی فولڈر سنبھالنا چاہتے ہیں تو چھوٹا دائرہ کار منتخب کریں۔"

msgid "You picked ~/Downloads. Files there are usually transient — consider a stable folder instead."
msgstr "آپ نے ~/Downloads منتخب کیا۔ وہاں فائلیں عموماً عارضی ہوتی ہیں — اس کے بجائے کسی مستقل فولڈر پر غور کریں۔"

msgid "You're all set up!"
msgstr "آپ کا سب کچھ تیار ہے!"

msgid "You're pushing more often than you check for updates. If others write to this repo too, pushes will often have to pull and try again."
msgstr "آپ اپ ڈیٹس دیکھنے سے زیادہ بار پُش کر رہے ہیں۔ اگر اس ریپو میں دوسرے لوگ بھی لکھتے ہیں، تو پُش کو اکثر پہلے تبدیلیاں کھینچ کر دوبارہ کوشش کرنی پڑے گی۔"

msgid "You're signed out — sign in to resume syncing."
msgstr "آپ سائن آؤٹ ہیں — مطابقت پذیری جاری رکھنے کے لیے سائن اِن کریں۔"

msgid "You're subscribed!"
msgstr "آپ رکن بن گئے!"

msgid "you@company.com"
msgstr "you@company.com"

msgid "Your agents still load this skill, but OpenKnowledge can't open or edit it: it won't index a file that git is set to ignore, because syncing it would fail. Adding one line to {gitignorePath} makes it editable here."
msgstr "آپ کے ایجنٹ اب بھی یہ مہارت لوڈ کرتے ہیں، لیکن OpenKnowledge اسے کھول یا ترمیم نہیں کر سکتا: یہ ایسی فائل کو انڈیکس نہیں کرتا جسے نظر انداز کرنے کے لیے git مقرر ہے، کیونکہ سنک ناکام ہو جائے گا۔ {gitignorePath} میں ایک سطر شامل کرنے سے یہ یہاں قابلِ ترمیم ہو جاتی ہے۔"

msgid "Your change is still being saved — run the test again in a moment."
msgstr "آپ کی تبدیلی ابھی محفوظ ہو رہی ہے — تھوڑی دیر بعد ٹیسٹ دوبارہ چلائیں۔"

msgid "Your comments are waiting behind the running turn — they stay queued until the agent picks the message up."
msgstr "آپ کے تبصرے جاری باری کے پیچھے انتظار کر رہے ہیں — ایجنٹ کے پیغام اٹھانے تک وہ قطار میں رہتے ہیں۔"

msgid "Your copy of branch <0>{shareBranch}</0> has changes that aren't on GitHub. The {targetNoun} will appear once the branch syncs."
msgstr "برانچ <0>{shareBranch}</0> کی آپ کی نقل میں ایسی تبدیلیاں ہیں جو GitHub پر نہیں۔ برانچ مطابق ہوتے ہی {targetNoun} ظاہر ہو جائے گا۔"

msgid "Your current version is saved first, so this is reversible."
msgstr "آپ کا موجودہ ورژن پہلے محفوظ ہو جاتا ہے، اس لیے یہ واپس لیا جا سکتا ہے۔"

msgid "Your documents are not touched."
msgstr "آپ کی دستاویزات میں کوئی تبدیلی نہیں کی جائے گی۔"

msgid "Your edits are committed and pushed to your remote automatically."
msgstr "آپ کی ترامیم خودکار طور پر کمٹ ہو کر آپ کے ریموٹ پر بھیج دی جاتی ہیں۔"

msgid "Your edits stay on this computer"
msgstr "آپ کی ترامیم اسی کمپیوٹر پر رہتی ہیں"

msgid "Your Git configuration names {declaredLogin}, but that account's credentials couldn't be used."
msgstr "آپ کی Git کنفیگریشن میں {declaredLogin} درج ہے، لیکن اس اکاؤنٹ کی کریڈینشلز استعمال نہیں ہو سکیں۔"

msgid "Your Git credential configuration names {declaredLogin}, but that account's credentials couldn't be used."
msgstr "آپ کی Git کریڈینشل کنفیگریشن میں {declaredLogin} درج ہے، لیکن اس اکاؤنٹ کی کریڈینشلز استعمال نہیں ہو سکیں۔"

msgid "Your GitHub session expired — sign in again to verify push access."
msgstr "آپ کا GitHub سیشن ختم ہو گیا — پُش کی رسائی کی توثیق کے لیے دوبارہ سائن اِن کریں۔"

msgid "Your GitHub token is missing required scopes. Try signing in again."
msgstr "آپ کے GitHub ٹوکن میں مطلوبہ دائرہ کار غائب ہیں۔ دوبارہ سائن اِن کر کے دیکھیں۔"

msgid "Your knowledge base is now on GitHub at <0>{ownerLogin}/{repoName}</0>."
msgstr "آپ کا نالج بیس اب GitHub پر <0>{ownerLogin}/{repoName}</0> پر ہے۔"

msgid "Your last open document couldn't be restored."
