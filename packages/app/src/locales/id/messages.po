msgstr "Saran tautan wiki"

msgid "Wiki-links like [[Page]] — a supported way to link here, but an external reader resolves nothing and shows the brackets."
msgstr "Tautan wiki seperti [[Page]] — cara yang didukung untuk membuat tautan di sini, tetapi pembaca eksternal tidak menyelesaikan apa pun dan memperlihatkan tanda kurung."

msgid "Will be created as <0>{effective}</0>"
msgstr "Akan dibuat sebagai <0>{effective}</0>"

msgid "Will be created as <0>{sanitizedName}</0>"
msgstr "Akan dibuat sebagai <0>{sanitizedName}</0>"

msgid "Will be created at: <0>{targetPreview}</0>"
msgstr "Akan dibuat di: <0>{targetPreview}</0>"

msgid "Will be saved as <0>{sanitized}</0>."
msgstr "Akan disimpan sebagai <0>{sanitized}</0>."

msgid "Window"
msgstr "Jendela"

