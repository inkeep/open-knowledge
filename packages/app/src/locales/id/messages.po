msgstr "Pakai jalur relatif di dalam keterampilan (tanpa .., tanpa spasi; SKILL.md dikelola sistem)."

msgid "Use a starter pack"
msgstr "Pakai paket awal"

msgid "Use a token instead"
msgstr "Pakai token saja"

msgid "Use an http:// or https:// origin."
msgstr "Gunakan origin http:// atau https://."

msgid "Use an https:// URL — http:// is only allowed for loopback endpoints."
msgstr "Pakai URL https:// — http:// hanya diizinkan untuk endpoint loopback."

msgid "Use letters, digits, <0>_</0> and <1>-</1> only."
msgstr "Pakai hanya huruf, angka, <0>_</0>, dan <1>-</1>."

msgid "Use letters, digits, <0>-</0> or <1>_</1> only."
msgstr "Pakai hanya huruf, angka, <0>-</0>, atau <1>_</1>."

msgid "Use lowercase letters, digits, and <0>-</0> only."
msgstr "Pakai hanya huruf kecil, angka, dan <0>-</0>."

msgid "Use lowercase letters, numbers, and hyphens only"
msgstr "Pakai hanya huruf kecil, angka, dan tanda hubung"

msgid "Use their version"
msgstr "Pakai versi mereka"

msgid "Use this starter pack"
msgstr "Pakai paket awal ini"

msgid "User"
msgstr "Pengguna"

msgid "User plugins are personal to this device — turn them on or off here. Each enabled plugin gets its own page under Plugins in the settings sidebar."
msgstr "Plugin pengguna bersifat pribadi untuk perangkat ini — nyalakan atau matikan di sini. Setiap plugin yang aktif mendapat halamannya sendiri di bawah Plugin pada bilah sisi pengaturan."

msgid "Username"
msgstr "Nama pengguna"

msgid "Using the <0>OK_EMBEDDINGS_API_KEY</0> environment variable (managed outside OpenKnowledge)."
msgstr "Memakai variabel lingkungan <0>OK_EMBEDDINGS_API_KEY</0> (dikelola di luar OpenKnowledge)."

msgid "Validate document frontmatter against JSON Schema files, scoped to doc sets by glob."
msgstr "Memvalidasi frontmatter dokumen terhadap berkas JSON Schema, dibatasi ke kumpulan dokumen lewat glob."

msgid "Validate document frontmatter against standard JSON Schema files (draft-06, draft-07, 2019-09, or 2020-12). Toggle a schema on to validate the docs its globs match; violations surface as warnings and never block a write. Use Edit to open the schema file."
msgstr "Memvalidasi frontmatter dokumen terhadap berkas JSON Schema standar (draft-06, draft-07, 2019-09, atau 2020-12). Nyalakan sebuah skema untuk memvalidasi dokumen yang cocok dengan glob-nya; pelanggaran muncul sebagai peringatan dan tidak pernah menghalangi penulisan. Gunakan Sunting untuk membuka berkas skemanya."

msgid "Value for {keyName}"
msgstr "Nilai untuk {keyName}"

msgid "Value is required"
msgstr "Nilai wajib diisi"

msgid "Values for {keyName}"
msgstr "Nilai untuk {keyName}"

