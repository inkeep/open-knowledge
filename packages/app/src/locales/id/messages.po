msgid "Use <0>{copyShortcut}</0> to copy the link below, or open OK in the desktop app."
msgstr "Gunakan <0>{copyShortcut}</0> untuk menyalin tautan di bawah, atau buka OK di aplikasi desktop."

msgid "Use a folder you already have."
msgstr "Pakai folder yang sudah Anda punya."

msgid "Use a lowercase .yaml or .yml extension"
