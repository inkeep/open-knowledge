{
  "name": "@inkeep/open-knowledge-app",
  "version": "0.0.0-unknown",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "exports": {
    "./test-support/agent-connections": {
      "@inkeep/source": "./src/lib/agent-connections.ts",
      "development": "./src/lib/agent-connections.ts",
      "types": "./src/lib/agent-connections.ts",
      "default": "./src/lib/agent-connections.ts"
    }
  },
  "scripts": {
    "predev": "turbo run build --filter=@inkeep/open-knowledge-core --filter=@inkeep/open-knowledge-server && sh scripts/i18n-compile-unless-skipped.sh && node scripts/copy-excalidraw-assets.mjs",
    "dev": "vite",
    "build": "node scripts/compile-i18n-catalogs.ts && node scripts/copy-excalidraw-assets.mjs && tsc --noEmit && vite build && pnpm run check:no-dev-harness",
    "check:no-dev-harness": "node scripts/check-dev-harness-absent.mjs",
    "typecheck": "node scripts/compile-i18n-catalogs.ts && tsc --noEmit",
    "i18n": "pnpm run i18n:extract && pnpm run i18n:compile",
    "i18n:extract": "lingui extract --clean --locale en,zh-Hans,zh-Hant,hi,es,ar,fr,bn,pt-BR,id,ur,ko,pl",
    "i18n:compile": "node scripts/compile-i18n-catalogs.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --config vitest.config.ts src/ tests/free-port.test.ts tests/temp-dir.test.ts tests/perf/fixtures/ tests/perf/lib/ tests/perf/profile.test.ts tests/perf/scenarios/sweep-cache-regime.smoke.test.ts tests/perf/scenarios/sweep-convention-cap-graduation.smoke.test.ts tests/stress/oracle-e-expectations.test.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:node": "vitest run --config vitest.node.config.ts",
    "check": "node scripts/compile-i18n-catalogs.ts && tsc --noEmit && biome check . && pnpm run test && pnpm run test:dom && pnpm run test:integration && pnpm run test:conversion && pnpm -w run test:uncached",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:shard1": "vitest run --config vitest.integration.config.ts --shard=1/6",
    "test:integration:shard2": "vitest run --config vitest.integration.config.ts --shard=2/6",
    "test:integration:shard3": "vitest run --config vitest.integration.config.ts --shard=3/6",
    "test:integration:shard4": "vitest run --config vitest.integration.config.ts --shard=4/6",
    "test:integration:shard5": "vitest run --config vitest.integration.config.ts --shard=5/6",
    "test:integration:shard6": "vitest run --config vitest.integration.config.ts --shard=6/6",
    "test:worker-lifetime": "vitest run --config vitest.worker-lifetime.config.ts",
    "test:perf:sessions": "vitest run --config vitest.config.ts tests/integration/per-session-um-perf.test.ts --testTimeout 60000",
    "test:conversion": "vitest run --config vitest.config.ts tests/conversion/",
    "test:stress:api": "node --import tsx tests/stress/stress-api.ts",
    "measure:fuzz": "bash scripts/measure-fuzz.sh",
    "measure:stress": "bash scripts/measure-stress.sh",
    "measure:sweep": "bash scripts/measure-sweep.sh",
    "perf:compare": "bash scripts/perf-compare.sh",
    "test:e2e": "playwright test",
    "test:e2e:install-browsers": "playwright install chromium webkit firefox",
    "test:perf": "vitest run tests/stress/component-blocks.perf.test.ts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "perf:fixtures": "node --import tsx tests/perf/fixtures/generate.ts",
    "perf:profile": "node --import tsx tests/perf/profile.ts",
    "sweep:cache-regime": "node --import tsx tests/perf/profile.ts --scenario=sweep-cache-regime",
    "sweep:convention-cap-graduation": "node --import tsx tests/perf/profile.ts --scenario=sweep-convention-cap-graduation",
    "probe:tiptap-leak": "node --import tsx tests/perf/probes/tiptap-destroy-leak.ts",
    "gen:color-themes": "node --import tsx scripts/gen-color-themes.ts",
    "audit:strings": "node --import tsx scripts/audit-strings/extract.ts",
    "audit:strings:casing": "node --import tsx scripts/audit-strings/check-casing.ts",
    "size": "turbo run build --filter=@inkeep/open-knowledge-app && size-limit"
  },
  "size-limit": [
    {
      "name": "main app bundle (gzipped)",
      "path": "dist/assets/index-*.js",
      "limit": "487 kB",
      "gzip": true,
      "running": false
    },
    {
      "name": "all JS chunks combined (gzipped)",
      "path": "dist/assets/*.js",
      "limit": "9.16 MB",
      "gzip": true,
      "running": false
    },
    {
      "name": "main CSS (gzipped)",
      "path": "dist/assets/index-*.css",
      "limit": "59 kB",
      "gzip": true,
      "running": false
    }
  ],
