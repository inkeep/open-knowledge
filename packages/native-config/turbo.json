{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "build.rs",
        "toolchain_guard.rs",
        "src/**/*.rs",
        "package.json",
        "scripts/build.mjs",
        "$TURBO_ROOT$/rust-toolchain.toml"
      ],
      "outputs": ["index.js", "index.d.ts", "*.node"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "$TURBO_ROOT$/rust-toolchain.toml"],
      "outputs": ["test-results/node-test-build.xml", "test-results/node-test-toolchain-guard.xml"]
    }
  }
}
